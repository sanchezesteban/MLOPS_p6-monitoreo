{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p5/comando/1.0",
  "title": "Comando v1 (grupo B -> adaptador)",
  "description": "Un mensaje por decision o evento. Reglas entre campos en config/contrato_v1.md y p5.contrato.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "frame_id", "event", "detections_ref",
    "state_before", "state_after", "action", "reason", "speed", "steering",
    "t_decision_ms", "t_command_ms", "valid_until_ms", "received", "error", "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": ["string", "null"], "minLength": 1},
    "event": {"type": ["string", "null"], "minLength": 1},
    "detections_ref": {"type": ["string", "null"], "minLength": 1},
    "state_before": {"type": "string", "minLength": 1},
    "state_after": {"type": "string", "minLength": 1},
    "action": {"enum": ["FORWARD", "STEER_LEFT", "STEER_RIGHT", "STOP"]},
    "reason": {"type": "string", "minLength": 1},
    "speed": {"type": "number", "minimum": 0, "maximum": 1},
    "steering": {"type": "number", "minimum": -1, "maximum": 1},
    "t_decision_ms": {"type": "number", "minimum": 0},
    "t_command_ms": {"type": "number", "minimum": 0},
    "valid_until_ms": {"type": ["number", "null"], "minimum": 0},
    "received": {"type": "boolean"},
    "error": {"type": ["string", "null"]},
    "synthetic": {"type": "boolean"}
  }
}
