{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p5/run_header/1.0",
  "title": "Cabecera de ejecucion v1",
  "description": "Una por corrida; identifica modelo, datos, configuracion, runtime, hardware y modo virtual.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "commit", "model_sha256", "config_sha256",
    "data_manifest_sha256", "runtime", "hardware", "virtual_mode", "t_start_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "minLength": 1},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "data_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "runtime": {"type": "string", "minLength": 1},
    "hardware": {"type": "string", "minLength": 1},
    "virtual_mode": {"type": "boolean"},
    "t_start_utc": {"type": "string", "minLength": 1},
    "replay_dt_ms": {
      "description": "Intervalo de reproduccion por cuadro dentro de cada secuencia; ausente si no se reproduce",
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
